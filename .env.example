# Copy this file to .env and fill in the empty values. Never commit .env.

# Frontend (Vite React App)
VITE_API_URL=http://localhost:3000
FRONTEND_PORT=5173

# Backend (Node.js Express Server)
NODE_ENV=development
PORT=3000

# Ports on your own computer when running with Docker
BACKEND_EXPOSED_PORT=3000
FRONTEND_EXPOSED_PORT=5173
DB_EXPOSED_PORT=5433

# Database used by "npm run dev:api" (PostgreSQL installed on your own computer)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movieapp

# Database container used by "docker compose up"
POSTGRES_DB=movieapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# JWT Secret (any long random string)
JWT_SECRET=change_me_to_a_long_random_string

# TMDB key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
